// =========================================================================
// Dala Market — DAX measures for Power BI
// Model: fact_sales (many) -> dim_date[date_key], dim_customer[customer_id],
//        dim_product[product_id], dim_order[order_id]  (all single-direction)
// Mark dim_date as a Date table on dim_date[date].
// Revenue is counted on DELIVERED orders only.
// =========================================================================

// ---------- Core ----------
Net Revenue =
CALCULATE ( SUM ( fact_sales[net_revenue] ), dim_order[status] = "delivered" )

COGS =
CALCULATE ( SUM ( fact_sales[cogs] ), dim_order[status] = "delivered" )

Gross Profit = [Net Revenue] - [COGS]

Gross Margin % = DIVIDE ( [Gross Profit], [Net Revenue] )

Discounts Given =
CALCULATE ( SUM ( fact_sales[discount_amount] ), dim_order[status] = "delivered" )

Orders =
CALCULATE ( DISTINCTCOUNT ( fact_sales[order_id] ), dim_order[status] = "delivered" )

All Orders = DISTINCTCOUNT ( fact_sales[order_id] )

AOV = DIVIDE ( [Net Revenue], [Orders] )

Active Customers =
CALCULATE ( DISTINCTCOUNT ( fact_sales[customer_id] ), dim_order[status] = "delivered" )

Revenue per Customer = DIVIDE ( [Net Revenue], [Active Customers] )

// ---------- Quality ----------
Returned Orders =
CALCULATE ( DISTINCTCOUNT ( fact_sales[order_id] ), dim_order[status] = "returned" )

Return Rate % = DIVIDE ( [Returned Orders], [All Orders] )

Avg Review =
CALCULATE ( AVERAGE ( dim_order[review_score] ), dim_order[status] <> "cancelled" )

Low Review % =
DIVIDE (
    CALCULATE ( COUNTROWS ( dim_order ), dim_order[review_score] <= 2 ),
    CALCULATE ( COUNTROWS ( dim_order ), NOT ISBLANK ( dim_order[review_score] ) )
)

// ---------- Time intelligence ----------
Revenue PY =
CALCULATE ( [Net Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Revenue YoY % = DIVIDE ( [Net Revenue] - [Revenue PY], [Revenue PY] )

Revenue YTD = TOTALYTD ( [Net Revenue], dim_date[date] )

Revenue MoM % =
VAR prev = CALCULATE ( [Net Revenue], DATEADD ( dim_date[date], -1, MONTH ) )
RETURN DIVIDE ( [Net Revenue] - prev, prev )

Revenue 3M Rolling =
CALCULATE ( [Net Revenue], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ) )

// ---------- Customers ----------
Repeat Customers =
COUNTROWS (
    FILTER (
        VALUES ( fact_sales[customer_id] ),
        CALCULATE ( [Orders] ) >= 2
    )
)

Repeat Rate % = DIVIDE ( [Repeat Customers], [Active Customers] )

Profit per Registered Customer =
DIVIDE ( [Gross Profit], COUNTROWS ( dim_customer ) )

// ---------- Share / ranking helpers ----------
Revenue Share % =
DIVIDE ( [Net Revenue], CALCULATE ( [Net Revenue], ALL ( dim_product[category] ) ) )

Category Rank =
RANKX ( ALL ( dim_product[category] ), [Net Revenue], , DESC )

Promo Margin vs Full Price (pp) =
[Gross Margin %]
    - CALCULATE ( [Gross Margin %], dim_order[promo_code] = "(none)" )
